COMPANIES_HTTP_ADDR=:8080
# COMPANIES_HTTP_SHUTDOWN_TIMEOUT=20s
# COMPANIES_HTTP_SHUTDOWN_DELAY=0s
COMPANIES_HTTP_DOCS_ENABLED=true
COMPANIES_HTTP_TRUST_TRACE_CONTEXT=true
# COMPANIES_HTTP_PPROF_ENABLED=false

COMPANIES_DATABASE_DSN=postgres://companies:companies@localhost:5432/companies?sslmode=disable
# COMPANIES_DATABASE_MAX_CONNS=10
COMPANIES_DATABASE_MIGRATE_ON_START=true

COMPANIES_KAFKA_BROKERS=localhost:19092
COMPANIES_KAFKA_TOPIC=companies.events.v1
COMPANIES_KAFKA_DEAD_LETTER_TOPIC=companies.events.v1.dlq
COMPANIES_KAFKA_CREATE_TOPIC=true
# COMPANIES_KAFKA_TLS_ENABLED=false
# COMPANIES_KAFKA_TLS_CA_FILE= # SASL: PLAIN (only with TLS), SCRAM-SHA-256 or SCRAM-SHA-512.
# COMPANIES_KAFKA_SASL_MECHANISM=
# COMPANIES_KAFKA_SASL_USERNAME=
# COMPANIES_KAFKA_SASL_PASSWORD=

COMPANIES_AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
COMPANIES_AUTH_ISSUER=companies-dev
COMPANIES_AUTH_AUDIENCE=companies-service

COMPANIES_LOG_LEVEL=info
COMPANIES_LOG_FORMAT=console

COMPANIES_TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio with OTEL_TRACES_SAMPLER_ARG=0.1.
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BLRP_SCHEDULE_DELAY=1000
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
