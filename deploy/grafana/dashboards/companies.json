{
  "uid": "companies-service",
  "title": "Companies service",
  "tags": [
    "companies"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(companies_http_request_duration_seconds_count{route!~\"GET /(healthz|readyz|metrics)\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route (click exemplars for traces)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(companies_http_request_duration_seconds_bucket{route!~\"GET /(healthz|readyz|metrics)\"}[5m])))",
          "legendFormat": "{{route}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses by status code",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(companies_http_request_duration_seconds_count{route!~\"GET /(healthz|readyz|metrics)\"}[1m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Events published and dead-lettered",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": null,
          "expr": "sum(rate(companies_events_published_total[1m]))",
          "legendFormat": "published"
        },
        {
          "refId": "B",
          "datasource": null,
          "expr": "sum(rate(companies_events_dead_lettered_total[1m]))",
          "legendFormat": "dead-lettered"
        },
        {
          "refId": "C",
          "datasource": null,
          "expr": "sum(rate(companies_http_request_duration_seconds_count{code=\"503\"}[1m]))",
          "legendFormat": "writes refused (Kafka unavailable)"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Dead-lettered events (topic companies.events.v1.dlq)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(companies_events_dead_lettered_total[24h]))",
          "legendFormat": "last 24h"
        },
        {
          "refId": "B",
          "expr": "sum(increase(companies_events_dead_lettered_total[1h]))",
          "legendFormat": "last 1h"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Health checks (1 up, 0.5 degraded, 0 down)",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down"
                },
                "0.5": {
                  "text": "degraded"
                },
                "1": {
                  "text": "up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "companies_health_check_status",
          "legendFormat": "{{probe}}: {{check}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "nodeGraph",
      "title": "Service graph (from traces)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap",
          "serviceMapQuery": "{}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Spans: rate, errors, p95 (span metrics)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "req/s"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "errors/s"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"companies-service\"}[5m]))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"companies-service\",status_code=\"STATUS_CODE_ERROR\"}[5m]))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"companies-service\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent traces",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"companies-service\" && span:kind=server}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"companies-service\"}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU: GOMAXPROCS vs cores used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_sched_gomaxprocs_threads{job=\"companies-service\"}",
          "legendFormat": "GOMAXPROCS"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"companies-service\"}[1m])",
          "legendFormat": "cores used"
        }
      ]
    }
  ]
}
